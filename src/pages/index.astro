---
import Layout from "../layouts/Layout.astro";
import { getProducts } from "../lib/sheets";

export const prerender = false;

const products = await getProducts();

const rawCategories = products
  .map(p => p.categoria?.toLowerCase().trim())
  .filter(Boolean);

const categoriasUnicas = [...new Set(rawCategories)].sort();

const categoriasDefinidas = [
  {
    id: "todos",
    texto: "Todos"
  },
  ...categoriasUnicas.map(cat => ({
    id: cat,
    texto: cat.charAt(0).toUpperCase() + cat.slice(1)
  }))
];
---

<Layout title="Noctura | Catálogo 3D">

  <!-- HEADER -->

  <header class="noctura-header">
    <div class="noctura-header-inner">

      <a href="/" class="noctura-logo">
        NOCTURA<span>3D</span>
      </a>

      <nav class="noctura-nav">
        <a href="/">Catálogo</a>
        <a href="/#categorias">Categorías</a>
      </nav>

    </div>
  </header>


  <main class="noctura-container">

    <!-- HERO -->

    <section class="catalog-header">

      <span class="catalog-eyebrow">
        Impresión 3D
      </span>

      <h1>
        Diseños que
        <span>se hacen realidad.</span>
      </h1>

      <p>
        Descubrí nuestros productos impresos en 3D
        y encontrá el diseño perfecto para vos.
      </p>

    </section>


    <!-- CATEGORÍAS -->

    <section id="categorias">

      <div class="categorias-wrapper">

        <button
          id="mobileMenuBtn"
          class="mobile-menu-trigger"
        >
          <span id="activeCategoryName">
            Todos
          </span>

          <span>
            ▾
          </span>
        </button>


        <div
          id="categoriesList"
          class="categorias-unificadas-container"
        >

          {categoriasDefinidas.map((cat, index) => (

            <button
              class={`categoria-btn ${
                index === 0 ? "active" : ""
              }`}
              data-categoria={cat.id}
            >
              {cat.texto}
            </button>

          ))}

        </div>

      </div>

    </section>


    <!-- BUSCADOR -->

    <div class="search-box-vibrant">

      <span class="search-icon">
        🔍
      </span>

      <input
        id="searchInput"
        type="text"
        placeholder="Buscar productos..."
        class="input-neon"
      />

    </div>


    <!-- PRODUCTOS -->

    <section
      id="productGrid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6"
    >

      {products.map(product => (

        <article
          class="product-item"
          data-nombre={String(
            product.nombre || ""
          ).toLowerCase()}
          data-categoria={String(
            product.categoria || ""
          ).toLowerCase().trim()}
        >

          <!-- IMAGEN -->

          <a
            href={`/producto/${product.id}`}
            class="product-image-area"
          >

            <img
              src={
                product.imagenes?.[0] ||
                "https://via.placeholder.com/400"
              }
              alt={product.nombre}
              loading="lazy"
            />

          </a>


          <!-- INFORMACIÓN -->

          <div class="product-info">

            <span class="product-category">
              {product.categoria || "Producto"}
            </span>

            <h2 class="product-title">
              {product.nombre}
            </h2>

            <p class="product-price">
              ${product.precio}
            </p>


            <div class="product-action">

              <a
                href={`/producto/${product.id}`}
                class="ver-detalles-btn"
              >
                Ver producto
              </a>

            </div>

          </div>

        </article>

      ))}

    </section>


    <!-- PAGINACIÓN -->

    <div
      id="paginationControls"
      class="pagination-container-vibrant"
    >

      <button
        id="prevPage"
        class="pagination-btn"
        aria-label="Página anterior"
      >

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>

      </button>


      <div class="page-info-wrapper">

        <span class="page-label">
          PÁGINA
        </span>

        <span
          id="pageInfo"
          class="page-counter"
        >
          1 / 1
        </span>

      </div>


      <button
        id="nextPage"
        class="pagination-btn"
        aria-label="Página siguiente"
      >

        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>

      </button>

    </div>

  </main>


  <script>

    const setupCatalog = () => {

      const input =
        document.getElementById(
          "searchInput"
        ) as HTMLInputElement;

      const items =
        Array.from(
          document.querySelectorAll(
            ".product-item"
          )
        ) as HTMLElement[];

      const botones =
        document.querySelectorAll(
          ".categoria-btn"
        );

      const prevBtn =
        document.getElementById(
          "prevPage"
        ) as HTMLButtonElement;

      const nextBtn =
        document.getElementById(
          "nextPage"
        ) as HTMLButtonElement;

      const pageInfo =
        document.getElementById(
          "pageInfo"
        );

      const menuBtn =
        document.getElementById(
          "mobileMenuBtn"
        );

      const catList =
        document.getElementById(
          "categoriesList"
        );

      const activeName =
        document.getElementById(
          "activeCategoryName"
        );


      const ITEMS_PER_PAGE = 6;

      let currentPage = 1;

      let filteredItems =
        [...items];


      /*
       * MOBILE MENU
       */

      menuBtn?.addEventListener(
        "click",
        () => {

          catList?.classList.toggle(
            "show"
          );

        }
      );


      /*
       * PAGINACIÓN
       */

      const updatePagination = () => {

        const totalPages =
          Math.ceil(
            filteredItems.length /
            ITEMS_PER_PAGE
          ) || 1;


        items.forEach(item => {

          item.style.display =
            "none";

        });


        const start =
          (currentPage - 1) *
          ITEMS_PER_PAGE;


        filteredItems
          .slice(
            start,
            start + ITEMS_PER_PAGE
          )
          .forEach(item => {

            item.style.display =
              "flex";

          });


        if (pageInfo) {

          pageInfo.textContent =
            `${currentPage} / ${totalPages}`;

        }


        if (prevBtn) {

          prevBtn.disabled =
            currentPage === 1;

        }


        if (nextBtn) {

          nextBtn.disabled =
            currentPage === totalPages;

        }

      };


      /*
       * FILTRO
       */

      const filtrar = (
        catId: string | null = null
      ) => {

        const busqueda =
          (
            input?.value || ""
          )
          .toLowerCase()
          .trim();


        const activeBtn =
          document.querySelector(
            ".categoria-btn.active"
          ) as HTMLElement;


        const catActual =
          catId ||
          activeBtn?.dataset.categoria ||
          "todos";


        filteredItems =
          items.filter(item => {

            const nombre =
              item.dataset.nombre || "";

            const categoria =
              item.dataset.categoria || "";


            return (
              nombre.includes(busqueda) &&
              (
                catActual === "todos" ||
                categoria === catActual
              )
            );

          });


        currentPage = 1;

        updatePagination();

      };


      /*
       * BUSCADOR
       */

      input?.addEventListener(
        "input",
        () => filtrar()
      );


      /*
       * CATEGORÍAS
       */

      botones.forEach(btn => {

        btn.addEventListener(
          "click",
          () => {

            botones.forEach(
              b =>
                b.classList.remove(
                  "active"
                )
            );


            btn.classList.add(
              "active"
            );


            if (
              window.innerWidth <= 640 &&
              activeName &&
              catList
            ) {

              activeName.textContent =
                btn.textContent ||
                "Todos";

              catList.classList.remove(
                "show"
              );

            }


            filtrar(
              (
                btn as HTMLElement
              ).dataset.categoria
              || null
            );

          }
        );

      });


      /*
       * BOTONES DE PÁGINA
       */

      nextBtn?.addEventListener(
        "click",
        () => {

          currentPage++;

          updatePagination();

          window.scrollTo({
            top: 250,
            behavior: "smooth"
          });

        }
      );


      prevBtn?.addEventListener(
        "click",
        () => {

          currentPage--;

          updatePagination();

          window.scrollTo({
            top: 250,
            behavior: "smooth"
          });

        }
      );


      /*
       * INICIO
       */

      filtrar();

    };


    setupCatalog();

    document.addEventListener(
      "astro:after-swap",
      setupCatalog
    );

  </script>

</Layout>