---
import Layout from "../../layouts/Layout.astro";
import { getProducts } from "../../lib/sheets";

export const prerender = false;

const id = Astro.params.id;

const products =
  await getProducts();

const product =
  products.find(
    p => String(p.id) === id
  );

const imagenes =
  product?.imagenes || [];

const relacionados =
  products
    .filter(
      p =>
        p.id !== product?.id &&
        p.categoria ===
          product?.categoria
    )
    .slice(0, 4);
---

<Layout
  title={
    product?.nombre ||
    "Producto | Noctura"
  }
>

  <!-- HEADER -->

  <!-- <header class="noctura-header">

    <div class="noctura-header-inner">

      <a
        href="/"
        class="noctura-logo"
      >
        NOCTURA<span>3D</span>
      </a>

      <nav class="noctura-nav">

        <a href="/">
          Catálogo
        </a>

        <a href="/#categorias">
          Categorías
        </a>

      </nav>

    </div>

  </header> -->


  <main class="noctura-container">


    <!-- BREADCRUMBS -->

    <!-- <div class="breadcrumbs">

      <a href="/">
        Inicio
      </a>

      <span class="breadcrumb-separator">
        ›
      </span>

      <a
        href={`/categoria/${product?.categoria}`}
      >
        {product?.categoria}
      </a>

      <span class="breadcrumb-separator">
        ›
      </span>

      <span class="current">
        {product?.nombre}
      </span>

    </div> -->


    {product ? (

      <>


        <!-- PRODUCTO PRINCIPAL -->

        <section
          class="product-detail-container"
        >

          <div
            class="grid grid-cols-1 md:grid-cols-2"
          >


            <!-- =========================
                 GALERÍA
                 ========================= -->

            <div class="product-gallery">

              <div
                class="main-image-container"
              >

                <img
                  id="mainImage"
                  src={imagenes[0]}
                  alt={product.nombre}
                  class="main-product-image"
                />

              </div>


              <!-- THUMBNAILS -->

              <div
                class="relative mt-4"
              >

                <button
                  id="prevBtn"
                  class="nav-arrow left-0 hidden md:flex z-10"
                  aria-label="Imagen anterior"
                >
                  ‹
                </button>


                <div
                  id="thumbScroll"
                  class="
                    flex
                    gap-3
                    overflow-x-auto
                    no-scrollbar
                    px-2
                    md:px-12
                    py-2
                  "
                >

                  {imagenes.map(
                    (img, index) => (

                    <div
                      class="thumb-card"
                      data-index={index}
                    >

                      <img
                        src={img}
                        alt={`${product.nombre} ${index + 1}`}
                      />

                    </div>

                  ))}

                </div>


                <button
                  id="nextBtn"
                  class="nav-arrow right-0 hidden md:flex z-10"
                  aria-label="Imagen siguiente"
                >
                  ›
                </button>

              </div>

            </div>


            <!-- =========================
                 INFORMACIÓN
                 ========================= -->

            <div
              class="details-panel"
            >

              <span
                class="product-detail-category"
              >
                {product.categoria}
              </span>


              <h1
                class="product-detail-title"
              >
                {product.nombre}
              </h1>


              <div
                class="product-detail-price"
              >
                ${product.precio}
              </div>


              <div class="price-note">
                Precio por unidad ·
                Consultá disponibilidad
              </div>


              <!-- INFORMACIÓN -->

              <div class="purchase-info">

                <div
                  class="purchase-info-item"
                >

                  <div
                    class="purchase-info-icon"
                  >
                    ✓
                  </div>

                  <span>
                    Impresión 3D de calidad
                  </span>

                </div>


                <div
                  class="purchase-info-item"
                >

                  <div
                    class="purchase-info-icon"
                  >
                    ⏱
                  </div>

                  <span>
                    Tiempo mínimo de entrega:
                    24 horas
                  </span>

                </div>


                <div
                  class="purchase-info-item"
                >

                  <div
                    class="purchase-info-icon"
                  >
                    🔒
                  </div>

                  <span>
                    Atención personalizada
                    por WhatsApp
                  </span>

                </div>

              </div>


              <!-- WHATSAPP -->

              <a
                href={`https://wa.me/+543764172282?text=${encodeURIComponent(
                  `Hola! Me interesa el producto: ${product.nombre}`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="whatsapp-btn"
              >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.16 1.6 5.97L.06 24l6.27-1.64a11.88 11.88 0 0 0 5.72 1.46h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.16-3.44-8.44ZM12.06 21.8h-.01a9.88 9.88 0 0 1-5.04-1.38l-.36-.21-3.72.97.99-3.62-.23-.37a9.87 9.87 0 0 1-1.51-5.29C2.18 6.46 6.61 2.02 12.06 2.02c2.64 0 5.12 1.03 6.98 2.9a9.84 9.84 0 0 1 2.89 7c0 5.45-4.43 9.88-9.87 9.88Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.87 1.21 3.07c.15.2 2.09 3.2 5.07 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35Z"
                  />
                </svg>

                Consultar por WhatsApp

              </a>


              <p
                style="
                  margin-top:12px;
                  text-align:center;
                  color:#8a8f98;
                  font-size:.72rem;
                "
              >
                Te responderemos directamente
                para confirmar disponibilidad,
                colores y detalles.
              </p>

            </div>

          </div>

        </section>


        <!-- =========================
             DESCRIPCIÓN
             ========================= -->

        <section
          class="product-section"
        >

          <h2>
            Descripción del producto
          </h2>

          <p
            class="product-description"
          >
            {product.descripcion}
          </p>

        </section>


        <!-- =========================
             CONDICIONES
             ========================= -->

        <section
          class="product-section"
        >

          <h2>
            Información de encargos
          </h2>

          <div
            class="product-description"
          >

            <p>
              • Se debe abonar el
              <strong>
                50%
              </strong>
              de adelanto.
            </p>

            <p>
              • Tiempo mínimo de entrega:
              <strong>
                24 horas
              </strong>.
            </p>

            <p>
              • El tiempo puede variar
              según la complejidad
              del diseño.
            </p>

          </div>

        </section>


        <!-- =========================
             BENEFICIOS
             ========================= -->

        <section
          class="product-section"
        >

          <h2>
            ¿Por qué comprar en Noctura?
          </h2>


          <div
            class="benefits-grid"
          >

            <div class="benefit">

              <div
                class="benefit-icon"
              >
                ✓
              </div>

              <div>

                <strong>
                  Impresión 3D
                </strong>

                <span>
                  Productos fabricados
                  mediante impresión 3D.
                </span>

              </div>

            </div>


            <div class="benefit">

              <div
                class="benefit-icon"
              >
                ⚙
              </div>

              <div>

                <strong>
                  Atención directa
                </strong>

                <span>
                  Consultá colores,
                  cantidades y disponibilidad.
                </span>

              </div>

            </div>


            <div class="benefit">

              <div
                class="benefit-icon"
              >
                ♡
              </div>

              <div>

                <strong>
                  Hecho para vos
                </strong>

                <span>
                  También podemos consultar
                  opciones personalizadas.
                </span>

              </div>

            </div>

          </div>

        </section>


        <!-- =========================
             PRODUCTOS RELACIONADOS
             ========================= -->

        {relacionados.length > 0 && (

          <section
            class="product-section"
          >

            <h2>
              También te puede interesar
            </h2>


            <div
              class="
                grid
                grid-cols-2
                md:grid-cols-4
                gap-4
              "
            >

              {relacionados.map(
                related => (

                <a
                  href={`/producto/${related.id}`}
                  style="
                    text-decoration:none;
                    color:inherit;
                  "
                >

                  <div
                    class="product-item"
                    style="
                      min-height:300px;
                    "
                  >

                    <div
                      class="product-image-area"
                      style="
                        height:190px;
                        margin:8px;
                      "
                    >

                      <img
                        src={
                          related.imagenes?.[0]
                        }
                        alt={related.nombre}
                      />

                    </div>


                    <div
                      class="product-info"
                    >

                      <span
                        class="product-category"
                      >
                        {related.categoria}
                      </span>

                      <h3
                        class="product-title"
                      >
                        {related.nombre}
                      </h3>

                      <div
                        class="product-price"
                        style="
                          font-size:1.15rem;
                        "
                      >
                        ${related.precio}
                      </div>

                    </div>

                  </div>

                </a>

              ))}

            </div>

          </section>

        )}

      </>

    ) : (

      <section
        class="product-section"
        style="
          text-align:center;
          margin-top:30px;
          padding:80px 20px;
        "
      >

        <h1>
          Producto no encontrado
        </h1>

        <p
          class="product-description"
        >
          El producto que buscás
          no existe o ya no está disponible.
        </p>

        <a
          href="/"
          class="ver-detalles-btn"
          style="
            max-width:220px;
            margin:25px auto 0;
          "
        >
          Volver al catálogo
        </a>

      </section>

    )}

  </main>


  <script>

    const setupGallery = () => {

      const mainImage =
        document.getElementById(
          "mainImage"
        ) as HTMLImageElement;


      const thumbs =
        Array.from(
          document.querySelectorAll(
            ".thumb-card"
          )
        ) as HTMLElement[];


      const scrollContainer =
        document.getElementById(
          "thumbScroll"
        );


      const prevBtn =
        document.getElementById(
          "prevBtn"
        );


      const nextBtn =
        document.getElementById(
          "nextBtn"
        );


      let currentIndex = 0;


      const updateImage = (
        index: number
      ) => {

        if (
          !thumbs[index] ||
          !mainImage
        ) {
          return;
        }


        const image =
          thumbs[index].querySelector(
            "img"
          ) as HTMLImageElement;


        if (!image) {
          return;
        }


        mainImage.style.opacity = "0";


        setTimeout(() => {

          mainImage.src =
            image.src;

          mainImage.style.opacity =
            "1";

        }, 120);


        currentIndex = index;


        thumbs.forEach(
          thumb =>
            thumb.style.borderColor =
              "transparent"
        );


        thumbs[index].style.borderColor =
          "#f97316";

      };


      thumbs.forEach(
        (thumb, index) => {

          thumb.addEventListener(
            "click",
            () => {

              updateImage(index);

            }
          );

        }
      );


      nextBtn?.addEventListener(
        "click",
        () => {

          if (
            currentIndex <
            thumbs.length - 1
          ) {

            updateImage(
              currentIndex + 1
            );

            scrollContainer?.scrollBy({
              left: 90,
              behavior: "smooth"
            });

          }

        }
      );


      prevBtn?.addEventListener(
        "click",
        () => {

          if (
            currentIndex > 0
          ) {

            updateImage(
              currentIndex - 1
            );

            scrollContainer?.scrollBy({
              left: -90,
              behavior: "smooth"
            });

          }

        }
      );


      if (thumbs.length > 0) {

        updateImage(0);

      }

    };


    setupGallery();


    document.addEventListener(
      "astro:after-swap",
      setupGallery
    );

  </script>

</Layout>